{
  "name": "agentcrucible",
  "version": "2.1.0",
  "description": "Fault-injection testing for tool-using AI agents: break tool calls on a seeded schedule in offline mock services, grade what the agent did and said against what actually committed, and track reliability over time in a local console with run history, analytics, sweeps, and a CI gate.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentcrucible": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenarios",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --clean --outDir dist && tsup src/ui/client/app.ts --format esm --platform browser --target es2022 --outDir dist/ui --minify && tsc -p tsconfig.build.json && npm run schema",
    "schema": "node dist/cli.js schema > schema/scenario.schema.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "demo": "node --import tsx src/cli.ts demo",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "agents",
    "tool-use",
    "fault-injection",
    "testing",
    "idempotency",
    "evaluation",
    "workflows",
    "replay",
    "chaos-engineering",
    "resilience"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skysssup/agentcrucible.git"
  },
  "homepage": "https://github.com/skysssup/agentcrucible",
  "bugs": {
    "url": "https://github.com/skysssup/agentcrucible/issues"
  }
}
