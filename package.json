{
  "name": "agentcrucible",
  "version": "1.1.0",
  "description": "Offline fault-injection tests for tool-using agents: scheduled tool failures in mock worlds, verdicts checked against committed state and the agent's answer, replayable traces, and a local UI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentcrucible": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenarios",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean --outDir dist && tsup src/ui/client/app.ts --format esm --platform browser --target es2022 --outDir dist/ui --minify && npm run schema",
    "schema": "node dist/cli.js schema > schema/scenario.schema.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "demo": "node --import tsx src/cli.ts demo",
    "dev": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "agents",
    "tool-use",
    "fault-injection",
    "testing",
    "idempotency",
    "evaluation",
    "workflows",
    "replay",
    "chaos-engineering",
    "resilience"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skysssup/agentcrucible.git"
  },
  "homepage": "https://github.com/skysssup/agentcrucible",
  "bugs": {
    "url": "https://github.com/skysssup/agentcrucible/issues"
  }
}
